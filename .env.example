# --- AI providers ---
GROQ_API_KEY=
# Hugging Face Inference API (text embeddings — BAAI/bge-small-en-v1.5)
HUGGINGFACE_API_KEY=

# Groq models
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# Caps concurrent Groq calls from the background ingest fan-out
GROQ_BATCH_MAX_CONCURRENCY=2

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Frontend-only (Vite exposes VITE_*)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8000

# --- Queue ---
UPSTASH_REDIS_URL=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
